# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ---------- 阿里云百炼（不填 Key 自动进入 mock 模式，可离线跑通流程） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
LLM_MODEL=qwen-plus
VL_MODEL=qwen-vl-max
IMAGE_MODEL=wan2.2-t2i-flash
IMAGE_SIZE=1024*1024
# AI_MOCK=true

# ---------- 基础设施（与 docker-compose.yml 的端口对应） ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/game_asset_agent
REDIS_URL=redis://localhost:6381/0
TASK_MODE=celery
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=game-assets

# ---------- 没有 Docker 时的本地开发配置（替换上面对应项） ----------
# DATABASE_URL=sqlite:///./.data/app.db
# TASK_MODE=thread
# STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=./.data/storage

# ---------- 流程参数 ----------
WANX_RATE_LIMIT=20/m
MAX_AUTO_RETRIES=2
MAX_HUMAN_ROUNDS=3
REVIEW_PASS_SCORE=7
MAX_IMAGES_PER_TASK=16
